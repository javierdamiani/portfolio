---
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Desktop from '@/components/os/Desktop';
import { projects } from '@/data/projects';
import type { OptimizedImage, ProjectImages } from '@/types';
import hello from '@/assets/memoji/hello.png';

const images: ProjectImages = Object.fromEntries(
  await Promise.all(
    projects.map(async (project) => {
      const optimized: OptimizedImage[] = await Promise.all(
        project.images.map(async ({ src, alt }) => {
          const img = await getImage({ src, width: 1280, format: 'webp', quality: 80 });
          return {
            src: img.src,
            width: Number(img.attributes.width ?? img.options.width ?? src.width),
            height: Number(img.attributes.height ?? img.options.height ?? src.height),
            alt,
          };
        }),
      );
      return [project.id, optimized] as const;
    }),
  ),
);

const portraitImg = await getImage({ src: hello, width: 420, format: 'webp', quality: 80 });
const portrait: OptimizedImage = {
  src: portraitImg.src,
  width: Number(portraitImg.attributes.width ?? 420),
  height: Number(portraitImg.attributes.height ?? Math.round((420 * hello.height) / hello.width)),
  alt: { en: 'Memoji of Javier waving hello', es: 'Memoji de Javier saludando' },
};
---

<Base>
  <Desktop client:load images={images} portrait={portrait} />
</Base>
